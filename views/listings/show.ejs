<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-md-8 offset-md-2">
    <h4><b><%= listing.title %></b></h4>
  </div>

  <div class="card col-md-8 offset-md-2 show-card listing-card">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing_image" />
    <div class="card-body mt-2">
      <p class="card-text">Owned by <i>@<%= listing.owner ? listing.owner.username : "Host" %></i></p>
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night</p>
      <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
    </div>
  </div>

  <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
    <div class="col-md-8 offset-md-2 d-flex gap-3 mb-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  <% } %>

  <div class="col-md-8 offset-md-2">
    <hr />
    <% if (currUser) { %>
      <h4>Leave a Review</h4>
      <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
          <div class="invalid-feedback">Please write a review comment.</div>
        </div>

        <button class="btn btn-outline-dark mb-3">Submit</button>
      </form>
      <hr />
    <% } %>

    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <p><b>All Reviews</b></p>
      <div class="row">
        <% for (let review of listing.reviews) { %>
          <div class="card col-md-5 ms-md-3 mb-3 p-3 border">
            <div class="card-body">
              <h5 class="card-title">@<%= review.author ? review.author.username : "Guest" %></h5>
              <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
              <p class="card-text"><%= review.comment %></p>
            </div>
            <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
              <form class="mt-2" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
      <hr />
    <% } %>
  </div>

  <div class="col-md-8 offset-md-2 mb-4">
    <h3>Where you'll be</h3>
    <div
      id="map"
      style="height: 400px; width: 100%; border-radius: 1rem; overflow: hidden; background: #e9ecef; border: 1px solid #dee2e6;"
    ></div>
  </div>
</div>

<script>
  (async function () {
    const mapContainer = document.getElementById("map");
    if (!mapContainer) return;

    const token = "<%= typeof mapToken !== 'undefined' ? mapToken : '' %>";
    const listingTitle = <%- JSON.stringify(listing.title || "Listing Location") %>;
    const listingPlace = <%- JSON.stringify([listing.location, listing.country].filter(Boolean).join(", ")) %>;
    const savedCoords = <%- JSON.stringify(listing.geometry && Array.isArray(listing.geometry.coordinates) && listing.geometry.coordinates.length === 2 ? listing.geometry.coordinates : [0, 0]) %>;

    // 1. Resolve [lng, lat] coordinates (geocode via OpenStreetMap if saved coords are [0, 0])
    let coords = [79.9865, 14.4426]; // Default fallback [lng, lat]
    if (
      Array.isArray(savedCoords) &&
      savedCoords.length === 2 &&
      (Number(savedCoords[0]) !== 0 || Number(savedCoords[1]) !== 0)
    ) {
      coords = [Number(savedCoords[0]), Number(savedCoords[1])];
    } else if (listingPlace) {
      try {
        const geoRes = await fetch(
          `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(listingPlace)}`
        );
        const geoData = await geoRes.json();
        if (Array.isArray(geoData) && geoData.length > 0) {
          coords = [parseFloat(geoData[0].lon), parseFloat(geoData[0].lat)];
        }
      } catch (_) {}
    }

    const [lng, lat] = coords;

    // Guaranteed iframe fallback if external JS map libraries are blocked
    function renderIframeFallback() {
      const delta = 0.08;
      const bbox = `${lng - delta},${lat - delta},${lng + delta},${lat + delta}`;
      mapContainer.innerHTML = `<iframe
        title="Location Map"
        width="100%"
        height="400"
        frameborder="0"
        scrolling="no"
        src="https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bbox)}&layer=mapnik&marker=${lat},${lng}"
        style="border: 0; display: block;"
      ></iframe>`;
    }

    // Load Leaflet + OpenStreetMap dynamically
    function renderLeafletMap() {
      if (!document.querySelector('link[href*="leaflet.css"]')) {
        const css = document.createElement("link");
        css.rel = "stylesheet";
        css.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
        document.head.appendChild(css);
      }

      const mountLeaflet = () => {
        try {
          mapContainer.innerHTML = "";
          const leafletMap = L.map("map").setView([lat, lng], 10);
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "&copy; OpenStreetMap contributors",
          }).addTo(leafletMap);
          L.marker([lat, lng])
            .addTo(leafletMap)
            .bindPopup(`<b>${listingTitle}</b><br>${listingPlace}`)
            .openPopup();
        } catch (_) {
          renderIframeFallback();
        }
      };

      if (typeof L !== "undefined") {
        mountLeaflet();
      } else {
        const script = document.createElement("script");
        script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
        script.onload = mountLeaflet;
        script.onerror = renderIframeFallback;
        document.head.appendChild(script);
      }
    }

    // 2. Verify MAP_TOKEN before using Mapbox so an expired token never renders a blank canvas
    if (token) {
      try {
        const checkRes = await fetch(
          `https://api.mapbox.com/geocoding/v5/mapbox.places/India.json?access_token=${encodeURIComponent(token)}&limit=1`
        );
        if (checkRes.ok && typeof mapboxgl !== "undefined") {
          mapboxgl.accessToken = token;
          const map = new mapboxgl.Map({
            container: "map",
            style: "mapbox://styles/mapbox/streets-v12",
            center: [lng, lat],
            zoom: 9,
          });
          map.addControl(new mapboxgl.NavigationControl());
          new mapboxgl.Marker({ color: "#fe424d" })
            .setLngLat([lng, lat])
            .addTo(map);
          map.on("error", () => {
            try { map.remove(); } catch (_) {}
            renderLeafletMap();
          });
          return;
        }
      } catch (_) {}
    }

    // 3. Render OpenStreetMap when MAP_TOKEN is expired or missing
    renderLeafletMap();
  })();
</script>