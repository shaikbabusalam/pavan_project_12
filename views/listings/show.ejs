<% layout("/layouts/boilerplate") -%>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(listing.location.coordinates) %> ;
</script>

<div class="row mt-3">
  <div class="col-8 offset-3">
 <p><h4><b><%= listing.title%></b></h4></p>
  </div>

  <div class="card col-6 offset-3 show-card">
     <div class="card-img-overlay"></div>
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing_image">
   
     <div class="card-body show-card">
      <p class="card-text">
  Owned by <%= listing.owner.username  %>
</p>
          <p class="card-text"><%= listing.description %></p>
         <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %> </p>
          <p class="card-text"><%= listing.location %> </p>
         <p class="card-text"><%= listing.country %> </p>
        
      </div>
  </div>
<% if(currUser && currUser._id.equals(listing.owner)) { %>
  <div class="btns mb-3">
      
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-edit col-1 offset-3">Edit </a>
   
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-dark  offset-5">delete </button>
    </form>
  </div>
<% }  %>
 
<hr/>


<div class="col-6 offset-3">
  <form method="POST" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
    <div class="mb-3 mt-3">
      <label for="rating" class="form-label">Rating </label> 
      <input type="range" class="form-label" name="review[rating]" min="1" max="5" required />      
    </div>
    <fieldset class="starability-slot">
  <legend>First rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="rating" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="rating" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="rating" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="rating" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="rating" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>


  <div class="mb-3 mt-3">
    <label for="comment" class="form-label"></label>
    <textarea name="review[comment]" id="rating" col="6" rows="5" class="form-control" required></textarea>
    <div class="invalid-feedback">write a feedback</div>
  </div>    
<button class="btn btn-dark">Submit</button>
  </form>

</div>

<br/>
<% if(listing.reviews.length>0) { %>
<div class="row">
  <p><b>All reviews</b></p>
  <% for(review of listing.reviews) { %>
    
  <div class="card col-5 ms-3 mb-3">
     <div class="card-body">
      <h5  class="card-title">review.author.username</h5>
      <p class="card-text"><%=review.comment %></p>
        <h3>Rated element name</h3>
  <p class="starability-result card-text" data-rating="<%= review.rating %>">
    
  </p>

     </div>
     <form class="mb-3 mt-3" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
      <button class="btn btn-dark ">Delete</button>
     </form>
  </div>


  <% } %>
</div>

<% } %>

</div>
<divclass="col-6 offset-3 mb-3" >
  <h3>Where you'll be</h3>
  <div id="map"></div>


</div>
</div>

<script src="/js/map.js"></script>