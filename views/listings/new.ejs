<% layout("/layouts/boilerplate.ejs") -%>
<body>
    <h3>Create new listing</h3>
    <div class="row ">
        <div class="col-8 offset-2">
    <form method="POST"  action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label  for="text"   class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="enter a lively title" class="form-control" required>
            <div class="valid-feedback">Title looks good!</div>
            <div class="invalid-feedback">Title should be mandatory</div>
        </div>

        <div class="mb-3">
            <lable  for="description"   class="form-label">description</lable>
                  <textarea name="listing[description]"  class="form-control" required></textarea>
                 <div class="invalid-feedback">description should be mandatory</div>
                  
        </div>

        <div  class="mb-3">
             <lable for="image"   class="form-label"> upload Image</lable>
             <input type="file" name="listing[image]" class="form-control">
               <div class="invalid-feedback">link is mandatory to image</div>
        </div>


        <div class="row">
              <div  class="mb-3 col-md-4 ">
         <lable  for="price"   class="form-label">Price</lable>
         <input type="text" name="listing[price]" class="form-control" placeholder="1200" required>
           <div class="invalid-feedback">price should be put</div>
      
        </div>

        <div  class="mb-3 col-md-8">
           <lable for="country"   class="form-label">Country</lable>   
         <input type="text" name="listing[country]" placeholder="India" class="form-control" required>
           <div class="invalid-feedback">country name should be mandatory</div>
                  
        </div>

        </div>
      
        <div  class="mb-3">
             <lable  for="location"   class="form-label">Location</lable>
             <input type="text" name="listing[location]" placeholder="enter location" class="form-control" >
               <div class="invalid-feedback">location should be mandatory</div>
                      
     
        <button class="btn  btn-dark add-btn mt-3 mb-3">Add</button>
       
    </form>
        </div>
    </div>
    
</body>
