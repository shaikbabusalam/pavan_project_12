<% layout("/layouts/boilerplate.ejs") -%>
<body>
    <h3>edit your listing</h3>
  
<div class="row ">
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="col-8 offset-2">
            <form method="POST"  action="/listings">
        <div class="mb-3">
            <label  for="text"   class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="enter a lively title" class="form-control" value="<%= listing.title%>" required>
            <div class="valid-feedback">Title looks good!</div>
            <div class="invalid-feedback">Title should be mandatory</div>
        </div>

         <div class="mb-3">
            <lable  for="description"   class="form-label">description</lable>
                  <textarea name="listing[description]"  class="form-control" required>
                    <%= listing.description %> 
                  </textarea>
        </div>

        <div  class="mb-3">
             <lable for="image"   class="form-label">Upload Image</lable>
             <input type="file" name="listing[image]"  class="form-control"   >
        </div>


        <div class="row">
              <div  class="mb-3 col-md-4 ">
         <lable  for="price"   class="form-label">Price</lable>
         <input type="number" name="listing[price]" class="form-control" placeholder="1200" value="<%= listing.price%>" required>
         <div class="invalid-feedback">price should be valid.</div>
        </div>

        <div  class="mb-3 col-md-8">
           <lable for="country"   class="form-label">Country</lable>   
         <input type="text" name="listing[country]" placeholder="India" class="form-control" value="<%= listing.country%>" required>
         <div class="invalid-feedback">country should be valid.</div>
        </div>

        </div>
      
        <div  class="mb-3">
             <lable  for="location"   class="form-label">Location</lable>
             <input type="text" name="listing[location]" placeholder="enter location" class="form-control" value="<%= listing.location%>" required>
             <div class="invalid-feedback">location should be valid.</div>
        </div>
        <button class="btn  btn-dark edit-btn mt-3 mb-3">edit</button>
 
    </form>
        </div>
    </div>
    

</body>


